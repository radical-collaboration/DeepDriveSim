s.tar.gz\n","-rw------- 1 root root        181 Jul 27 01:30 'Untitled spreadsheet.gsheet'\n","drwx------ 2 root root       4096 Aug 24 02:07  \u001b[01;34mGraph_neural_networks\u001b[0m/\n","-rw------- 1 root root        181 Aug 24 22:56  Category2_Pharma_Biotech_Internships.gsheet\n"]}]},{"cell_type":"code","source":["import os\n","os.chdir(\"/content/drive/MyDrive/Colab Notebooks/GMVAE/\")"],"metadata":{"id":"hAl-uGOzgmqe","executionInfo":{"status":"ok","timestamp":1788511808816,"user_tz":240,"elapsed":1163,"user":{"displayName":"Rishabh Singh","userId":"01507751272304595948"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["%%writefile subgraphs.py\n","import numpy as np\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","n_h = 16\n","use_batch_norm = False\n","\n","def gaussian_sample(mean, var):\n","    \"\"\"Sample from Gaussian distribution\"\"\"\n","    sample = torch.normal(mean,std=torch.sqrt(var))\n","    return sample\n","\n","def log_normal(x, mu, var, eps=0.0, dim=-1):\n","    \"\"\"Compute log probability of x under Gaussian N(mu, var)\"\"\"\n","    x = x.to(torch.float32)\n","    mu = mu.to(torch.float32)\n","    var = var.to(torch.float32)\n","\n","    if eps > 0.0:\n","        var = torch.add(var, eps) # clipped var\n","\n","    log_2pi = torch.tensor(np.log(2.0 * np.pi), dtype=torch.float32, device=x.device)\n","\n","    log_prob = -0.5 * torch.sum(\n","        log_2pi + torch.log(var) + (x - mu)**2/var,\n","        dim=dim\n","    )\n","\n","    return log_prob\n","\n","#===============================================================\n","# Layer builders\n","#===============================================================\n","\n","def build_qy_layers(k, hidden_dims=[16,16]):\n","    \"\"\"\n","    Build layers for q(y|x) network - inference network for clustering assignment\n","\n","    Args:\n","        k: Number of mixture components\n","        hidden_dims: List of hidden layer dimensions\n","\n","    Returns:\n","        layers: List of Dense\n","        output_layers: Final output layers\n","    \"\"\"\n","    layers = []\n","\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers).to(torch.float32)\n","\n","    # Output Layer\n","    output_layer = nn.Sequential(\n","        nn.LazyLinear(k),\n","        nn.ReLU()\n","    ).to(torch.float32)\n","\n","    return  hidden_stack, output_layer\n","\n","def build_qz_layers(n_z, k, hidden_dims=[16,16]):\n","    \"\"\"\n","    Build layers for q(z|x,y) network - inference network for latent variable\n","\n","    Args:\n","        n_z: Dimension of latent variable z\n","        k: Number of mixture components (needed for y transformation)\n","        hidden_dims: List of hidden layer dimensions\n","\n","    Returns:\n","        y_transform_layer: Layer to transform y\n","        hidden_layers: List of hidden layers\n","        zm_layer: Mean output layer\n","        zv_layer: Variance output layer\n","    \"\"\"\n","    y_transform_layer = nn.Sequential(\n","        nn.LazyLinear(k),\n","        nn.ReLU()\n","    )\n","\n","    layers = []\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dims))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","           layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers).to(torch.float32)\n","\n","    # Mean and variance layers\n","    zm_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.ReLU()\n","    ).to(torch.float32)\n","    zv_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.Softplus()\n","    ).to(torch.float32)\n","\n","    return y_transform_layer, hidden_stack, zm_layer, zv_layer\n","\n","def build_pz_layers(n_z, hidden_dims=[16]):\n","    \"\"\"\n","    Build layers for p(z|y) network - prior network for latent variable\n","\n","    Args:\n","        n_z: Dimension of latent variable z\n","        hidden_dims: List of hidden layer dimensions\n","\n","    Returns:\n","        hidden_layers: List of hidden layers\n","        zm_layer: Mean output layer\n","        zv_layer: Variance output layer\n","    \"\"\"\n","    layers = []\n","\n","    for i,hidden_dim in enumerate(hidden_dims):\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","\n","    zm_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.ReLU()\n","    ).to(torch.float32)\n","    zv_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.Softplus()\n","    ).to(torch.float32)\n","\n","    return hidden_stack, zm_layer, zv_layer\n","\n","def build_px_layers(n_x, hidden_dims=[16,16]):\n","    \"\"\"\n","    Build layers for p(x|z) network - generative network for reconstruction\n","\n","    Args:\n","        n_x: Dimension of observable variable x\n","        hidden_dims: List of hidden layer dimensions\n","\n","    Returns:\n","        hidden_layers: List of hidden layers\n","        xm_layer: Mean output layer\n","        xv_layer: Variance output layer\n","    \"\"\"\n","    layers = []\n","    for i,hidden_dim in enumerate(hidden_dims):\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","\n","    xm_layer = nn.Sequential(\n","        nn.LazyLinear(n_x),\n","        nn.ReLU()\n","    )\n","    xv_layer = nn.Sequential(\n","        nn.LazyLinear(n_x),\n","        nn.ReLU()\n","    )\n","\n","    return hidden_stack, xm_layer, xv_layer\n","\n","def execute_qy_graph(x, layers, output_layer):\n","    \"\"\"\n","    Execute q(y|x) network using pre-built layers.\n","\n","    Args:\n","        x: Input tensor [batch_size, n_x]\n","        layers: Pre-built hidden layers (nn.Sequential or nn.ModuleList)\n","        output_layer: Pre-built output layer (nn.Linear / nn.LazyLinear)\n","\n","    Returns:\n","        qy_logit: Logits [batch_size, k]\n","        qy: Categorical probabilities [batch_size, k]\n","    \"\"\"\n","    # Forward through hidden layers\n","    h = layers(x) if isinstance(layers, nn.Sequential) else x\n","    if isinstance(layers, (list, nn.ModuleList)):\n","        for layer in layers:\n","            h = layer(h)\n","\n","    # Compute logits and softmax probabilities along last dimension\n","    qy_logit = output_layer(h)\n","    qy = F.softmax(qy_logit, dim=-1)\n","\n","    return qy_logit, qy\n","\n","def reparameterize(mean, var):\n","    \"\"\"\n","    Gaussian reparameterization trick: z = mean + std * epsilon\n","    \"\"\"\n","    std = torch.sqrt(var)\n","    eps = torch.randn_like(std)\n","    return mean + eps * std\n","\n","def execute_qz_graph(x, y, y_transform_layer, hidden_layers, zm_layer, zv_layer):\n","    \"\"\"\n","    Execute q(z|x,y) network using pre-built layers\n","\n","    Args:\n","        x: Input tensor [batch_size, n_x]\n","        y: One-hot cluster assignment [batch_size, k]\n","        y_transform_layer: Pre-built y transformation layer (nn.Linear / nn.Sequential)\n","        hidden_layers: Pre-built hidden layers (nn.Sequential or nn.ModuleList)\n","        zm_layer: Pre-built mean layer (nn.Linear)\n","        zv_layer: Pre-built variance layer (nn.Linear)\n","\n","    Returns:\n","        z: Sampled latent variable [batch_size, n_z]\n","        zm: Mean [batch_size, n_z]\n","        zv: Variance [batch_size, n_z]\n","    \"\"\"\n","    # Transform y\n","    h0 = y_transform_layer(y)\n","\n","    # Concatenate x and transformed y along feature dimension (dim=1)\n","    xy = torch.cat([x, h0], dim=1)\n","\n","    # Pass through hidden layers\n","    if isinstance(hidden_layers, nn.Sequential):\n","        h = hidden_layers(xy)\n","    else:\n","        h = xy\n","        for layer in hidden_layers:\n","            h = layer(h)\n","\n","    # Latent Gaussian parameters\n","    zm = zm_layer(h)\n","\n","    # Ensure numerical stability with variance (softplus/exp or clipping is often preferred)\n","    zv = zv_layer(h) + 1e-5\n","\n","    # Reparameterized sampling\n","    z = gaussian_sample(zm, zv)\n","\n","    return z, zm, zv\n","\n","def execute_pz_graph(y, hidden_layers, zm_layer, zv_layer):\n","    \"\"\"\n","    Execute p(z|y) prior network using pre-built layers\n","\n","    Args:\n","        y: One-hot cluster assignment [batch_size, k]\n","        hidden_layers: Pre-built hidden layers (nn.Sequential or nn.ModuleList)\n","        zm_layer: Pre-built mean layer (nn.Linear)\n","        zv_layer: Pre-built variance layer (nn.Linear)\n","\n","    Returns:\n","        y: Pass-through y [batch_size, k]\n","        zm: Prior Mean [batch_size, n_z]\n","        zv: Prior Variance [batch_size, n_z]\n","    \"\"\"\n","    # Pass cluster assignment y through hidden layers\n","    if isinstance(hidden_layers, nn.Sequential):\n","        h = hidden_layers(y)\n","    else:\n","        h = y\n","        for layer in hidden_layers:\n","            h = layer(h)\n","\n","    # Compute prior mean and variance for component y\n","    zm = zm_layer(h)\n","    zv = zv_layer(h) + 1e-5\n","\n","    return y, zm, zv\n","\n","def execute_px_graph(z, hidden_layers, xm_layer, xv_layer):\n","    \"\"\"\n","    Execute p(x|z) generative/decoder network using pre-built layers\n","\n","    Args:\n","        z: Latent variable [batch_size, n_z]\n","        hidden_layers: Pre-built hidden layers (nn.Sequential or nn.ModuleList)\n","        xm_layer: Pre-built mean layer (nn.Linear)\n","        xv_layer: Pre-built variance layer (nn.Linear)\n","\n","    Returns:\n","        xm: Reconstructed mean [batch_size, n_x]\n","        xv: Reconstructed variance [batch_size, n_x]\n","    \"\"\"\n","    # Pass latent vector z through decoder hidden layers\n","    if isinstance(hidden_layers, nn.Sequential):\n","        h = hidden_layers(z)\n","    else:\n","        h = z\n","        for layer in hidden_layers:\n","            h = layer(h)\n","\n","    # Compute output mean and variance parameters for x reconstruction\n","    xm = xm_layer(h)\n","\n","    # Enforce positive non-zero variance for stability\n","    # Note: If your output activation expects softplus/exp for variance, adjust accordingly\n","    xv = xv_layer(h) + 1e-5\n","\n","    return xm, xv\n","\n","def labeled_loss(k, x, xm, xv, z, zm, zv, zm_prior, zv_prior):\n","    \"\"\"\n","    Variational loss for the mixture VAE for a specific mixture component\n","\n","    Loss = -log p(x|z) + KL(q(z|x,y) || p(z|y)) - log(1/k)\n","    \"\"\"\n","    # Reconstruction loss: -log p(x|z)\n","    reconstruction_loss = -log_normal(x, xm, xv)\n","\n","    # KL divergence Monte Carlo estimate: log q(z|x,y) - log p(z|y)\n","    kl_loss = log_normal(z, zm, zv) - log_normal(z, zm_prior, zv_prior)\n","\n","    # Uniform prior log-probability over components: -log(1/k)\n","    mixture_prior = -torch.tensor(np.log(1.0 / k), dtype=torch.float32, device=x.device)\n","\n","    # Total loss per sample\n","    total_loss = reconstruction_loss + kl_loss + mixture_prior\n","\n","    return total_loss\n","\n","def z_graph(zm,zv):\n","    \"\"\"Sample z from p(z) = N(zm, zv)\"\"\"\n","    return gaussian_sample(zm, zv)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"m8tepmh5gN8B","executionInfo":{"status":"ok","timestamp":1788504958793,"user_tz":240,"elapsed":767,"user":{"displayName":"Rishabh Singh","userId":"01507751272304595948"}},"outputId":"601f39a0-bbbe-474f-d868-b1cda464d8f8"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting subgraphs.py\n"]}]},{"cell_type":"code","source":["%%writefile subgraphs.py\n","import numpy as np\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","use_batch_norm = False\n","\n","def gaussian_sample(mean, var):\n","    \"\"\"\n","    Gaussian reparameterization trick: z = mean + std * epsilon\n","    Allows backpropagation through stochastic sampling.\n","    \"\"\"\n","    std = torch.sqrt(torch.clamp(var, min=1e-7))\n","    eps = torch.randn_like(std)\n","    return mean + eps * std\n","\n","def log_normal(x, mu, var, eps=1e-5, dim=-1):\n","    \"\"\"Compute log probability of x under Gaussian N(mu, var)\"\"\"\n","    x = x.to(torch.float32)\n","    mu = mu.to(torch.float32)\n","    var = var.to(torch.float32)\n","\n","    if eps > 0.0:\n","        var = var + eps\n","\n","    log_2pi = torch.tensor(np.log(2.0 * np.pi), dtype=torch.float32, device=x.device)\n","\n","    log_prob = -0.5 * torch.sum(\n","        log_2pi + torch.log(var) + ((x - mu) ** 2) / var,\n","        dim=dim\n","    )\n","\n","    return log_prob\n","\n","#===============================================================\n","# Layer builders\n","#===============================================================\n","\n","def build_qy_layers(k, hidden_dims=[16, 16]):\n","    \"\"\"Build layers for q(y|x) network - cluster assignment\"\"\"\n","    layers = []\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","    output_layer = nn.LazyLinear(k)\n","\n","    return hidden_stack, output_layer\n","\n","def build_qz_layers(n_z, k, hidden_dims=[16, 16]):\n","    \"\"\"Build layers for q(z|x,y) network - inference network for latent variable\"\"\"\n","    y_transform_layer = nn.Sequential(\n","        nn.LazyLinear(k),\n","        nn.ReLU()\n","    )\n","\n","    layers = []\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","\n","    # Linear mean output, Softplus for strictly positive variance\n","    zm_layer = nn.LazyLinear(n_z)\n","    zv_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.Softplus()\n","    )\n","\n","    return y_transform_layer, hidden_stack, zm_layer, zv_layer\n","\n","def build_pz_layers(n_z, hidden_dims=[16]):\n","    \"\"\"Build layers for p(z|y) network - prior network for latent variable\"\"\"\n","    layers = []\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","\n","    zm_layer = nn.LazyLinear(n_z)\n","    zv_layer = nn.Sequential(\n","        nn.LazyLinear(n_z),\n","        nn.Softplus()\n","    )\n","\n","    return hidden_stack, zm_layer, zv_layer\n","\n","def build_px_layers(n_x, hidden_dims=[16, 16]):\n","    \"\"\"Build layers for p(x|z) network - generative network for reconstruction\"\"\"\n","    layers = []\n","    for hidden_dim in hidden_dims:\n","        layers.append(nn.LazyLinear(hidden_dim))\n","        layers.append(nn.ReLU())\n","        if use_batch_norm:\n","            layers.append(nn.BatchNorm1d(num_features=hidden_dim, momentum=0.01, eps=1e-3))\n","\n","    hidden_stack = nn.Sequential(*layers)\n","\n","    xm_layer = nn.LazyLinear(n_x)\n","    xv_layer = nn.Sequential(\n","        nn.LazyLinear(n_x),\n","        nn.Softplus()\n","    )\n","\n","    return hidden_stack, xm_layer, xv_layer\n","\n","#===============================================================\n","# Execution functions\n","#===============================================================\n","\n","def execute_qy_graphs(x, layers, output_layer, training=False):\n","    \"\"\"Execute q(y|x) network using pre-built layers\"\"\"\n","    h = layers(x)\n","    qy_logit = output_layer(h)\n","    qy = F.softmax(qy_logit, dim=-1)\n","    return qy_logit, qy\n","\n","def execute_qz_graph(x, y, y_transform_layer, hidden_layers, zm_layer, zv_layer, training=False):\n","    \"\"\"Execute q(z|x,y) network using pre-built layers\"\"\"\n","    h0 = y_transform_layer(y)\n","    xy = torch.cat([x, h0], dim=1)\n","    h = hidden_layers(xy)\n","\n","    zm = zm_layer(h)\n","    zv = zv_layer(h) + 1e-5\n","\n","    z = gaussian_sample(zm, zv)\n","    return z, zm, zv\n","\n","def execute_pz_graph(y, hidden_layers, zm_layer, zv_layer, training=False):\n","    \"\"\"Execute p(z|y) prior network using pre-built layers\"\"\"\n","    h = hidden_layers(y)\n","\n","    zm = zm_layer(h)\n","    zv = zv_layer(h) + 1e-5\n","\n","    return y, zm, zv\n","\n","def execute_px_graph(z, hidden_layers, xm_layer, xv_layer, training=False):\n","    \"\"\"Execute p(x|z) generative/decoder network using pre-built layers\"\"\"\n","    h = hidden_layers(z)\n","\n","    xm = xm_layer(h)\n","    xv = xv_layer(h) + 1e-5\n","\n","    return xm, xv\n","\n","def labeled_loss(k, x, xm, xv, z, zm, zv, zm_prior, zv_prior):\n","    \"\"\"\n","    Variational loss for GMVAE mixture component\n","    Loss = -log p(x|z) + KL(q(z|x,y) || p(z|y)) - log(1/k)\n","    \"\"\"\n","    reconstruction_loss = -log_normal(x, xm, xv)\n","    kl_loss = log_normal(z, zm, zv) - log_normal(z, zm_prior, zv_prior)\n","    mixture_prior = -torch.tensor(np.log(1.0 / k),